                  }
                ],
                "body": {
                  "mode": "raw",
                  "raw": "{\n  \"referenceNumber\": \"<string>\",\n  \"amount\": \"<double>\",\n  \"accountReference\": \"<string>\",\n  \"currency\": \"<string>\"\n}",
                  "options": {
                    "raw": {
                      "headerFamily": "json",
                      "language": "json"
                    }
                  }
                },
                "url": {
                  "raw": "{{baseUrl}}/chargeDebitMandate",
                  "host": [
                    "{{baseUrl}}"
                  ],
                  "path": [
                    "chargeDebitMandate"
                  ]
                }
              },
              "status": "OK",
              "code": 200,
              "_postman_previewlanguage": "json",
              "header": [
                {
