{
  "info": {
    "_postman_id": "38a82df6-0b33-40ef-9836-ed89375f0717",
    "name": "Paga Developer Business Reference API",
    "description": "Paga (Pagatech Financial Services Limited) is a Nigerian mobile-money and payments company licensed by the Central Bank of Nigeria. This document models three REST product surfaces: the Business API (disbursements, airtime/data, merchant payments, bank deposits, customer onboarding), the Collect API (NGN collections via payment requests and persistent payment account numbers), and the Direct Debit API (bank-account mandate tokenization and recurring charges). All amounts are in Nigerian Naira (NGN). Every request carries a SHA-512 `hash` header computed over an operation-specific ordered concatenation of parameters plus the account hash key.\n\nContact Support:\n Name: Paga Developer Support\n Email: businesssupport@paga.com",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "createdAt": "2026-07-28T02:31:10.000Z",
    "updatedAt": "2026-07-28T02:31:10.000Z",
    "lastUpdatedBy": "35240",
    "uid": "35240-38a82df6-0b33-40ef-9836-ed89375f0717"
  },
