{
  "opencollection": "1.0.0",
  "info": {
    "name": "Paga Developer Business Collect API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "hash",
      "value": "{{hash}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Collect",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Register a payment request",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.mypaga.com/paymentRequest",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Registers a new request for payment between a payer and payee. The payer is notified and can pay via bank transfer, USSD, card, agent, or Paga wallet; a callback is sent on fulfilment. The same path is used by the Direct Debit API to initiate bank-account mandate tokenization. hash = SHA-512(referenceNumber + amount + currency + payer.phoneNumber + payer.email + hashKey)."
        },
        {
          "info": {
            "name": "Check payment request / mandate status",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.mypaga.com/status",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Returns the status of a submitted operation (payment request, persistent account creation, or direct-debit tokenization) by reference number, including any refund information. hash = SHA-512(referenceNumber + hashKey)."
        },
        {
          "info": {
            "name": "Refund or cancel a payment request (v2)",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.mypaga.com/refund/v2",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Cancels or refunds a previously fulfilled or pending payment request."
        },
        {
          "info": {
            "name": "Retrieve collection history",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.mypaga.com/history",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Queries collection activity within a date range (maximum three months)."
        },
        {
          "info": {
            "name": "Create a persistent payment account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.mypaga.com/registerPersistentPaymentAccount",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Creates a reusable NUBAN account number assigned to a customer so the organization can collect payments any time via bank or Paga transfer."
        },
        {
          "info": {
            "name": "Retrieve a persistent payment account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.mypaga.com/getPersistentPaymentAccount",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Retrieve a persistent payment account"
        },
        {
          "info": {
            "name": "Update a persistent payment account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.mypaga.com/updatePersistentPaymentAccount",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Modifies account properties except the NUBAN and account reference."
        },
        {
          "info": {
            "name": "Delete a persistent payment account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.mypaga.com/deletePersistentPaymentAccount",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "basic",
              "username": "{{username}}",
              "password": "{{password}}"
            }
          },
          "docs": "Removes a persistent payment identifier. Irreversible."
        }
      ]
    }
  ],
  "bundled": true
}