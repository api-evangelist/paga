              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "principal",
              "value": "{{principal}}",
              "placement": "header"
            }
          },
          "docs": "Merchant / bill payment"
        },
        {
          "info": {
            "name": "Deposit to bank account",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.mypaga.com/paga-webservices/business-rest/secured/depositToBank",
            "body": {
              "type": "json",
