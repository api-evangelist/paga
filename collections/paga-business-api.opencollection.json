        {
          "info": {
            "name": "Register a customer",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.mypaga.com/paga-webservices/business-rest/secured/registerCustomer",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "principal",
              "value": "{{principal}}",
              "placement": "header"
