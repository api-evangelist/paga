{
  "opencollection": "1.0.0",
  "info": {
    "name": "Paga Developer Business API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "hash",
      "value": "{{hash}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "Business",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Money transfer / disbursement",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.mypaga.com/paga-webservices/business-rest/secured/moneyTransfer",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "principal",
              "value": "{{principal}}",
              "placement": "header"
            }
          },
          "docs": "Transfers money from the business Paga account to a recipient phone number or bank account. hash = SHA-512(referenceNumber + amount + destinationAccount + destinationBank + hashKey)."
        },
        {
          "info": {
            "name": "Airtime & data purchase",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://www.mypaga.com/paga-webservices/business-rest/secured/airtimePurchase",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "principal",
              "value": "{{principal}}",
              "placement": "header"
            }
          },
          "docs": "Airtime & data purchase"
        },
        {
          "info": {
            "name": "Merchant / bill payment",
