            "method": "POST",
            "url": "https://www.mypaga.com/paga-webservices/business-rest/secured/validateDepositToBank",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "apikey",
              "key": "principal",
              "value": "{{principal}}",
              "placement": "header"
            }
          },
          "docs": "Validate a bank deposit (name enquiry)"
        },
        {
          "info": {
